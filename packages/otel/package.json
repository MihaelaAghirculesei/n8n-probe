{
  "name": "@n8n-probe/otel",
  "version": "0.2.0",
  "description": "OpenTelemetry tracing for n8n node executions, with span assertions for tests",
  "keywords": [
    "n8n",
    "opentelemetry",
    "tracing",
    "observability"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/n8n-probe.git",
    "directory": "packages/otel"
  },
  "homepage": "https://github.com/MihaelaAghirculesei/n8n-probe/tree/main/packages/otel#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "n8n-workflow": "^2.16.0"
  },
  "devDependencies": {
    "@n8n-probe/core": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "n8n-workflow": "^2.45.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
