{
  "name": "@n8n-probe/unit",
  "version": "0.1.2",
  "description": "Execute a single n8n node class with inputs and params and assert on its output",
  "keywords": [
    "n8n",
    "testing",
    "unit",
    "node"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/n8n-probe.git",
    "directory": "packages/unit"
  },
  "homepage": "https://github.com/MihaelaAghirculesei/n8n-probe/tree/main/packages/unit#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@n8n-probe/core": "workspace:^"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.16.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@n8n-probe/core": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "n8n-nodes-probe-example": "workspace:*",
    "n8n-workflow": "^2.44.2",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
