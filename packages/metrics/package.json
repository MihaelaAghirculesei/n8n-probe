{
  "name": "@n8n-probe/metrics",
  "version": "0.1.0",
  "description": "n8n node execution metrics recorded via the OpenTelemetry Metrics API and exposed for Prometheus",
  "keywords": [
    "n8n",
    "opentelemetry",
    "metrics",
    "prometheus",
    "observability"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/n8n-probe.git",
    "directory": "packages/metrics"
  },
  "homepage": "https://github.com/MihaelaAghirculesei/n8n-probe/tree/main/packages/metrics#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
