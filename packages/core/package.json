{
  "name": "@n8n-probe/core",
  "version": "0.3.0",
  "description": "Typed mock n8n execution context and data fixtures for testing custom nodes",
  "keywords": [
    "n8n",
    "testing",
    "mock",
    "IExecuteFunctions"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/n8n-probe.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MihaelaAghirculesei/n8n-probe/tree/main/packages/core#readme",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "vitest-mock-extended": "^5.1.1"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.16.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "n8n-workflow": "^2.44.2",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
