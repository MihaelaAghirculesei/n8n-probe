{
  "name": "@n8n-probe/mock-http",
  "version": "0.1.2",
  "description": "HTTP mocking helpers and presets for testing n8n nodes that call external APIs",
  "keywords": [
    "n8n",
    "testing",
    "http",
    "msw",
    "mock"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MihaelaAghirculesei/n8n-probe.git",
    "directory": "packages/mock-http"
  },
  "homepage": "https://github.com/MihaelaAghirculesei/n8n-probe/tree/main/packages/mock-http#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:e2e:full": "vitest run --config vitest.full.config.ts"
  },
  "dependencies": {
    "@n8n-probe/core": "workspace:^",
    "axios": "^1.20.0"
  },
  "peerDependencies": {
    "msw": "^3.0.0",
    "n8n-workflow": "^2.16.0",
    "testcontainers": "^12.0.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "testcontainers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@n8n-probe/core": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "msw": "^3.0.3",
    "n8n-nodes-probe-example": "workspace:*",
    "n8n-workflow": "^2.44.2",
    "testcontainers": "^12.2.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
