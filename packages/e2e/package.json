{
  "name": "@n8n-probe/e2e",
  "version": "0.0.0",
  "description": "Build and run whole n8n workflows in tests: fast in-process by default, real instance opt-in",
  "keywords": [
    "n8n",
    "testing",
    "e2e",
    "workflow",
    "testcontainers"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8n-probe/n8n-probe.git",
    "directory": "packages/e2e"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --coverage",
    "test:e2e:full": "vitest run --config vitest.full.config.ts"
  },
  "dependencies": {
    "@n8n-probe/core": "workspace:^",
    "testcontainers": "^12.1.0"
  },
  "peerDependencies": {
    "n8n-core": "^2.16.0",
    "n8n-workflow": "^2.16.0"
  },
  "devDependencies": {
    "@n8n-probe/core": "workspace:*",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.11",
    "n8n-core": "^2.16.1",
    "n8n-workflow": "^2.16.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
