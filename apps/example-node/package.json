{
  "name": "n8n-nodes-probe-example",
  "version": "0.0.0",
  "private": true,
  "description": "Example n8n node used as a shared fixture across the n8n-probe test suites",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Example/Example.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint nodes",
    "test": "vitest run"
  },
  "peerDependencies": {
    "n8n-workflow": "^2.16.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "n8n-workflow": "^2.16.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
